@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-3">TesteFull</MudText>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-4" />
        <MudSpacer />
        <MudText Typo="Typo.body1" Class="mr-4">Blazor</MudText>
        <MudSpacer />
        <MudTooltip Text="API Docs">
            <MudIconButton Icon="@Icons.Material.Filled.Description" Color="Color.Inherit" Href="http://localhost:3000/api" Target="_blank" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudText Typo="Typo.h6" Class="px-4 mt-4 mb-2">Menu</MudText>
            <MudDivider Class="mb-2" />
            <MudNavLink Href="/persons" Icon="@Icons.Material.Filled.Group" Match="NavLinkMatch.Prefix">Pessoas</MudNavLink>
            
            <MudText Typo="Typo.subtitle2" Class="px-4 mt-4 mb-2" Style="color: gray;">APIs</MudText>
            <MudNavLink Href="http://localhost:3000/api" Target="_blank" Icon="@Icons.Material.Filled.Description">API Docs</MudNavLink>
            <MudNavLink Href="http://localhost:3000/openapi.json" Target="_blank" Icon="@Icons.Material.Filled.DataObject">API JSON</MudNavLink>
            <MudNavLink Href="http://localhost:3000/persons" Target="_blank" Icon="@Icons.Material.Filled.List">API Persons</MudNavLink>
            <MudNavLink Href="http://localhost:3000/" Target="_blank" Icon="@Icons.Material.Filled.Home">API Root</MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="pa-4">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = false;
    
    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = Colors.Indigo.Default,
            Secondary = Colors.Pink.Accent2,
            AppbarBackground = Colors.Indigo.Default
        }
    };

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
